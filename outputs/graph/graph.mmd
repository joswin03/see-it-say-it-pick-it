---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	find_regions(find_regions)
	name_regions(name_regions)
	build_scene(build_scene)
	check_safety(check_safety)
	plan(plan)
	check_plan(check_plan)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> check_safety;
	__start__ -.-> find_regions;
	build_scene --> check_safety;
	check_plan -.-> finalize;
	check_plan -.-> plan;
	check_safety -.-> finalize;
	check_safety -.-> plan;
	find_regions --> name_regions;
	name_regions --> build_scene;
	plan --> check_plan;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
